# Port on which the API server runs
PORT=5000

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb://localhost:27017/huffaz_db

# JSON Web Token Secret (used for signing and verifying authorization tokens)
JWT_SECRET=your_jwt_secret_here

# Runtime environment ('development' or 'production')
NODE_ENV=development

# CORS Allowed Origins (Comma-separated list of origins)
# Mobile clients often send requests without an Origin header.
# This config restricts access for web browsers in production.
ALLOWED_ORIGINS=http://localhost:19000,http://localhost:8081,http://localhost:19006

